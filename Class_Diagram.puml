@startuml
title Restaurant Reservation System (UML Profile)

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

'=====================
' APPLICATION LAYER
'=====================
package "Application Layer" {

class RestaurantService <<Application>>
}

'=====================
' RESOURCE LAYER
'=====================
package "Resource Layer" {

class Restaurants <<Resource>> {
  <<Path>> /api/v1/restaurants
  --
  <<GET>>  getRestaurants()
  <<POST>> createRestaurant()
}

class Restaurant <<Resource>> {
  <<Path>> /api/v1/restaurants/{id}
  --
  <<GET>>    getRestaurant()
  <<PUT>>    updateRestaurant()
  <<DELETE>> deleteRestaurant()
}

class Reservations <<Resource>> {
  <<Path>> /api/v1/reservations
  --
  <<GET>> getReservations()
}

class Reservation <<Resource>> {
  <<Path>> /api/v1/reservations/{id}
  --
  <<GET>>    getReservation()
  <<PUT>>    updateReservation()
  <<DELETE>> deleteReservation()
}

class RestaurantReservations <<Resource>> {
  <<Path>> /api/v1/restaurants/{restaurantId}/reservations
  --
  <<POST>> addReservation()
}

}

'=====================
' REPRESENTATION LAYER
'=====================
package "Representation Layer" {

class User <<Representation>> {
  name: String
  email: String
  role: String
  password: String
  createdAt: Date
}

class RestaurantModel <<Representation>> {
  name: String
  address: String
  tel: String
  openingHours: String
}

class ReservationModel <<Representation>> {
  apptDate: Date
  user: ObjectId
  restaurant: ObjectId
  createdAt: Date
}

}

'=====================
' CLEAN CONNECTIONS
'=====================

RestaurantService --> Restaurants
RestaurantService --> Reservations

Restaurants ..> Restaurant : {id}
Restaurant ..> RestaurantReservations : /reservations
Reservations ..> Reservation : {id}

Restaurants --> RestaurantModel
Restaurant --> RestaurantModel

Reservations --> ReservationModel
Reservation --> ReservationModel
RestaurantReservations --> ReservationModel

ReservationModel --> User
ReservationModel --> RestaurantModel

@enduml