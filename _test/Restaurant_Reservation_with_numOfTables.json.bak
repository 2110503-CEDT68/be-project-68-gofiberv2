              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); }); var jsonData = pm.response.json(); pm.test('Checking reservation is cancelled', function () { pm.expect(jsonData.data.status).to.eql('cancelled'); });"
