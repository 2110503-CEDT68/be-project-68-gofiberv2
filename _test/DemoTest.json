      "name": "DemoTests",
      "item": [
        {
          "name": "01. User Registration + Validation Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "// pm.request.body.raw is a string, needs parsing",
                  "var payload = JSON.parse(pm.request.body.raw);",
                  "pm.environment.set(\"token\", jsonData.token);",
                  "pm.environment.set(\"created_user_email\", payload.email);",
                  "pm.environment.set(\"created_user_pass\", payload.password);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"{{$randomFullName}}\",\n    \"email\": \"{{$randomEmail}}\",\n    \"password\": \"password123\",\n    \"tel\": \"0987654321\",\n    \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{URL}}/api/v1/auth/register",
              "host": [
                "{{URL}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
